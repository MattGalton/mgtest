@startuml
title mgtest — system context
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center

legend right
|= Colour |= Responsibility |
|<#D6EAF8> Blue | Entry points |
|<#D5F5E3> Green | Project planning |
|<#FDEBD0> Orange | Test execution |
|<#E8DAEF> Purple | Pluggable test and resource types |
|<#FADBD8> Pink | Run artifacts |
endlegend

actor "Developer or CI" as caller
component "pytest\ncollection + reporting" as pytest #D6EAF8
component "mgtest CLI\ninit · run · home · tooling" as cli #D6EAF8

package "mgtest" {
  component "Project loader\nYAML suites, vars, definitions" as loader #D5F5E3
  component "Planner\nvalidation + dependency graph" as planner #D5F5E3
  component "Execution session\nresource lifecycle + checks" as session #FDEBD0
  component "Plugin catalog\nbuilt-ins, entry points, local plugins" as catalog #E8DAEF
  component "Resource and test specs\nExecutable, HTTP, Docker, S3, custom types" as specs #E8DAEF
  component "Run workspace\nmanifest, outputs, logs, failures" as workspace #FADBD8
}

folder "mgtest project\nYAML + builtin/ plugins" as project
database ".mgtest/\ncache and run history" as state
cloud "System under test\nprocesses, services, files, Docker, Git" as sut

caller --> pytest : pytest mgtest/
caller --> cli : mgtest run
pytest --> catalog
pytest --> loader
cli --> catalog
cli --> loader
catalog --> specs : registered types
loader --> planner : project model
catalog --> planner : type catalog
planner --> session : compiled plan
session --> specs : create and run instances
session --> workspace : record evidence
workspace --> state
session --> sut : set up resources\nand perform checks
project --> loader
project --> catalog : builtin/
@enduml
